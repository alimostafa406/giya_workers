# Keep this file local. Never put any of these values in Vercel or frontend variables.
# Preferred multi-device configuration. Add DEVICE_3_* etc. when required.
HIKVISION_DEVICE_1_ID=office-main
HIKVISION_DEVICE_1_IP=192.168.0.213
HIKVISION_DEVICE_1_USERNAME=admin
HIKVISION_DEVICE_1_PASSWORD=
HIKVISION_DEVICE_2_ID=office-secondary
HIKVISION_DEVICE_2_IP=
HIKVISION_DEVICE_2_USERNAME=admin
HIKVISION_DEVICE_2_PASSWORD=
# Legacy single-device HIKVISION_DEVICE_IP / HIKVISION_USERNAME /
# HIKVISION_PASSWORD remains supported while migrating.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional defaults used by the local dry run.
HIKVISION_TIMEZONE=+01:00
HIKVISION_SYNC_DRY_RUN=true

# Attendance Agent schedule and production switch. Keep false until the first
# production verification is approved. --dry-run always overrides this switch.
HIKVISION_AGENT_ATTENDANCE_INTERVAL_SECONDS=300
HIKVISION_AGENT_USERS_INTERVAL_SECONDS=1800
HIKVISION_AGENT_HEARTBEAT_INTERVAL_SECONDS=60
HIKVISION_AGENT_ENABLE_ATTENDANCE_WRITES=false
