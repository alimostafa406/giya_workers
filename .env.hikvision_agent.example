# Copy to .env.hikvision_sync on the office laptop only. Never commit the copy.
# Multi-device; add DEVICE_3_* etc. as needed. Legacy HIKVISION_DEVICE_IP / USERNAME / PASSWORD remains supported.
HIKVISION_DEVICE_1_ID=office-main
HIKVISION_DEVICE_1_IP=192.168.0.213
HIKVISION_DEVICE_1_USERNAME=admin
HIKVISION_DEVICE_1_PASSWORD=
HIKVISION_DEVICE_2_ID=office-secondary
HIKVISION_DEVICE_2_IP=
HIKVISION_DEVICE_2_USERNAME=admin
HIKVISION_DEVICE_2_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional agent identity and schedule. Seconds: attendance defaults to 5 minutes; users to 30.
HIKVISION_AGENT_ID=office-attendance-agent
HIKVISION_AGENT_ATTENDANCE_INTERVAL_SECONDS=300
HIKVISION_AGENT_USERS_INTERVAL_SECONDS=1800
HIKVISION_AGENT_HEARTBEAT_INTERVAL_SECONDS=60
HIKVISION_AGENT_LOG_DIR=logs

# Deliberately false for the first test. Set to true only after a successful
# --once --dry-run review on a normal (non-test) workday.
HIKVISION_AGENT_ENABLE_ATTENDANCE_WRITES=false
